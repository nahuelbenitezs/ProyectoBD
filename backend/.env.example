# Copiar a backend/.env (NO subir el .env a GitHub)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=torneo_ucu
# Usar las cuentas técnicas creadas por torneo_ucu_creacion.sql.
MYSQL_ADMIN_USER=torneo_app_administrador
MYSQL_ADMIN_PASSWORD=
MYSQL_PLANILLERO_USER=torneo_app_planillero
MYSQL_PLANILLERO_PASSWORD=
# Frontend servido en local con python -m http.server 5500
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
PORT=5000
# Tiempo de vida de la sesión: 12 horas
SESSION_TTL_SECONDS=43200
